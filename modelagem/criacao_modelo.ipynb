   "source": [
    "# Retorno acumulado 5 dias\n",
    "ibovespa[\"ret_5\"] = np.log(ibovespa[\"fechamento\"] / ibovespa[\"fechamento\"].shift(5))"
   ]
  },
  {
   "cell_type": "code",
