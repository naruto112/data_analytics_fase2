    "# Inclinação da MM20\n",
    "ibovespa[\"slope_mm20\"] = (ibovespa[\"mm20\"] - ibovespa[\"mm20\"].shift(1)) / ibovespa[\"mm20\"].shift(1)"
   ]
  },
